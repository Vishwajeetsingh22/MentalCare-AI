<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Stress &amp; Burnout Analytics"
            android:textColor="@color/primary_teal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Track your stress scores over time and monitor multi-day burnout risk patterns."
            android:textColor="@color/text_subtle"
            android:textSize="13sp" />

        <!-- Interactive Custom Graph Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Stress Score Trajectory"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt7DayAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="7-Day Avg: 63%"
                    android:textColor="@color/primary_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Custom Canvas Chart View -->
            <com.aimentalcare.app.ui.StressChartView
                android:id="@+id/stressChartView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <!-- Burnout Detection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Burnout Pattern Detector"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBurnoutBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@color/stress_high_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="HIGH RISK"
                    android:textColor="@color/stress_high"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Burnout Progression List (Day 1 -> Day 6) -->
            <TextView
                android:id="@+id/txtBurnoutProgression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F8FAFC"
                android:padding="12dp"
                android:text="Day 1 (35%) → Day 2 (48%) → Day 3 (62%) → Day 4 (71%) → Day 5 (79%) → Day 6 (84%)"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/bannerBurnoutAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/stress_moderate_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Increasing Stress Pattern Detected"
                    android:textColor="@color/stress_moderate"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBurnoutMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your stress level has increased consistently over the past 5 days. Consider taking time to rest and talking to someone you trust."
                    android:textColor="@color/text_dark"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnRecalculateBurnout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_green"
                android:text="🔄 Run Real-Time Burnout Scan"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
